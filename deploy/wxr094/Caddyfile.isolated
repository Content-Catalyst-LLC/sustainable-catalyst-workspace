# Isolated CI simulation of the existing Workspace-origin matchers plus the
# narrowly proposed persistence routes. This is not the production Caddyfile.
:18080 {
    @session path /v1/session /v1/session/*
    handle @session {
        reverse_proxy 127.0.0.1:8089
    }

    @private_research path /v1/private-research /v1/private-research/*
    handle @private_research {
        reverse_proxy 127.0.0.1:8089
    }

    @workspace_persistence path /v1/user-workspace /v1/user-workspace/* /v1/projects /v1/projects/* /v1/artifacts /v1/artifacts/*
    handle @workspace_persistence {
        reverse_proxy 127.0.0.1:8089
    }

    handle {
        respond "isolated static" 200
    }
}
