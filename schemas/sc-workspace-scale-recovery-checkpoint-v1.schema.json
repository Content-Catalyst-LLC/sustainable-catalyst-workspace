{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace Scale Recovery Checkpoint",
  "type": "object",
  "required": [
    "schema",
    "pressureLevel",
    "metrics",
    "contentIncluded"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-scale-recovery-checkpoint/1.0"
    },
    "pressureLevel": {
      "enum": [
        "normal",
        "attention",
        "critical"
      ]
    },
    "contentIncluded": {
      "const": false
    }
  }
}
