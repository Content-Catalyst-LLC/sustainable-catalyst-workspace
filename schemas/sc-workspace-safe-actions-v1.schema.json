{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-safe-actions-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Safe Actions",
  "type": "object",
  "required": ["schema", "history", "updatedAt"],
  "properties": {
    "schema": {"const": "sc-workspace-safe-actions/1.0"},
    "history": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "required": ["schema", "id", "action", "actionLabel", "projectId", "projectTitle", "outcome", "reviewAvailable", "reviewSummary", "baseline", "target", "acknowledged", "at"],
        "properties": {
          "schema": {"const": "sc-workspace-safe-actions/1.0"},
          "id": {"type": "string", "maxLength": 160},
          "action": {"enum": ["restore-copy", "sync-resolve-local", "sync-resolve-cloud", "share-portable", "share-review-copy", "institutional-promotion"]},
          "actionLabel": {"type": "string", "maxLength": 160},
          "projectId": {"type": "string", "maxLength": 160},
          "projectTitle": {"type": "string", "maxLength": 200},
          "outcome": {"enum": ["proceeded", "cancelled", "blocked"]},
          "reviewAvailable": {"type": "boolean"},
          "reviewSummary": {
            "type": "object",
            "required": ["added", "removed", "modified", "total", "relationshipsChanged", "categoriesChanged"],
            "properties": {
              "added": {"type": "integer", "minimum": 0},
              "removed": {"type": "integer", "minimum": 0},
              "modified": {"type": "integer", "minimum": 0},
              "total": {"type": "integer", "minimum": 0},
              "relationshipsChanged": {"type": "integer", "minimum": 0},
              "categoriesChanged": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "baseline": {"$ref": "#/$defs/stateRef"},
          "target": {"$ref": "#/$defs/stateRef"},
          "checkpointRestorePointId": {"type": "string", "maxLength": 160},
          "acknowledged": {"type": "boolean"},
          "at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": true
      }
    },
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "stateRef": {
      "type": "object",
      "required": ["kind", "label"],
      "properties": {
        "kind": {"type": "string", "maxLength": 80},
        "label": {"type": "string", "maxLength": 200},
        "id": {"type": "string", "maxLength": 160},
        "restorePointId": {"type": "string", "maxLength": 160}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
