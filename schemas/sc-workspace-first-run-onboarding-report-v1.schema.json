{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-first-run-onboarding-report-v1.schema.json",
  "title": "Workspace First-Run Onboarding Report",
  "type": "object",
  "required": ["schema", "workspaceVersion", "firstRun", "projectCount", "privacy", "governance"],
  "properties": {
    "schema": {"const": "sc-workspace-first-run-onboarding-report/1.0"},
    "workspaceVersion": {"type": "string"},
    "generatedAt": {"type": "string"},
    "firstRun": {"type": "boolean"},
    "projectCount": {"type": "integer", "minimum": 0},
    "storageWritable": {"type": "boolean"},
    "authenticated": {"type": "boolean"},
    "starterCount": {"const": 5},
    "privacy": {"type": "object"},
    "governance": {"type": "object"}
  },
  "additionalProperties": true
}
