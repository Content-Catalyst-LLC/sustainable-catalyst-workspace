{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace Institutional Export Shard Manifest",
  "type": "object",
  "required": [
    "schema",
    "recordCount",
    "shardCount",
    "shards"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-institutional-export-shard-manifest/1.0"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0
    },
    "shardCount": {
      "type": "integer",
      "minimum": 1
    },
    "shards": {
      "type": "array"
    }
  }
}
