{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-decision-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decisions",
    "options",
    "criteria",
    "assessments",
    "risks",
    "activeDecisionId",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-decision/1.0"
    },
    "decisions": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "question",
          "status",
          "decisionObjectId",
          "selectedOptionId",
          "rationale",
          "confidence",
          "createdAt",
          "updatedAt",
          "decidedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "question": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "framing",
              "evaluating",
              "decided",
              "revisit"
            ]
          },
          "decisionObjectId": {
            "type": "string",
            "maxLength": 160
          },
          "selectedOptionId": {
            "type": "string",
            "maxLength": 160
          },
          "rationale": {
            "type": "string",
            "maxLength": 6000
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "decidedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "options": {
      "type": "array",
      "maxItems": 240,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decisionId",
          "label",
          "description",
          "status",
          "evidenceObjectIds",
          "analysisObjectIds",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "decisionId": {
            "type": "string",
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2400
          },
          "status": {
            "enum": [
              "candidate",
              "shortlisted",
              "selected",
              "rejected"
            ]
          },
          "evidenceObjectIds": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "analysisObjectIds": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "maxItems": 180,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decisionId",
          "label",
          "weight",
          "description",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "decisionId": {
            "type": "string",
            "maxLength": 160
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "description": {
            "type": "string",
            "maxLength": 1200
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decisionId",
          "optionId",
          "criterionId",
          "score",
          "note",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "decisionId": {
            "type": "string",
            "maxLength": 160
          },
          "optionId": {
            "type": "string",
            "maxLength": 160
          },
          "criterionId": {
            "type": "string",
            "maxLength": 160
          },
          "score": {
            "type": "number",
            "minimum": -5,
            "maximum": 5
          },
          "note": {
            "type": "string",
            "maxLength": 1200
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decisionId",
          "optionId",
          "risk",
          "likelihood",
          "impact",
          "mitigation",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "decisionId": {
            "type": "string",
            "maxLength": 160
          },
          "optionId": {
            "type": "string",
            "maxLength": 160
          },
          "risk": {
            "type": "string",
            "maxLength": 2400
          },
          "likelihood": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "type": "string",
            "maxLength": 2000
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    },
    "activeDecisionId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}