{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc-workspace-deployment-state-v1.schema.json",
  "title": "Workspace Server Deployment State",
  "type": "object",
  "required": ["schema", "workspace_version"],
  "properties": {
    "schema": {"const": "sc-workspace-deployment-state/1.0"},
    "workspace_version": {"type": "string"},
    "previous_observed_version": {"type": "string"},
    "source": {"type": "string"},
    "first_seen_at": {"type": "string"},
    "history_count": {"type": "integer", "minimum": 0, "maximum": 12}
  },
  "additionalProperties": true
}
