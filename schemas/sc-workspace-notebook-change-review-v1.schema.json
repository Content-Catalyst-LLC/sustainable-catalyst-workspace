{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-notebook-change-review-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Notebook Change Review v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "projectId",
    "notebookId",
    "base",
    "target",
    "summary",
    "categories",
    "changes",
    "createdAt",
    "governance"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-notebook-change-review/1.0"
    },
    "id": {
      "type": "string",
      "maxLength": 160
    },
    "projectId": {
      "type": "string",
      "maxLength": 160
    },
    "notebookId": {
      "type": "string",
      "maxLength": 160
    },
    "base": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "added",
        "removed",
        "modified",
        "total"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "changes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "key",
          "category",
          "change",
          "id",
          "label",
          "fields"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "change": {
            "enum": [
              "added",
              "removed",
              "modified"
            ]
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "governance": {
      "type": "object"
    }
  }
}
