{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-visualization-spec-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Visualization Specification",
  "type": "object",
  "required": ["schema", "rendererContract", "scene", "sources", "links", "policy", "specFingerprint"],
  "properties": {
    "schema": {"const": "sc-workspace-visualization-spec/1.0"},
    "rendererContract": {"type": "object", "required": ["schema", "rendererNeutral"]},
    "title": {"type": "string"},
    "scene": {
      "type": "object",
      "required": ["layout", "views"],
      "properties": {
        "layout": {"enum": ["single", "grid", "dashboard"]},
        "views": {"type": "array", "minItems": 1, "maxItems": 32}
      }
    },
    "sources": {"type": "array", "maxItems": 64},
    "links": {"type": "array", "maxItems": 128},
    "annotations": {"type": "array"},
    "policy": {"type": "object"},
    "specFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
