{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-recovery-candidate-v1.schema.json",
  "title": "Workspace Recovery Candidate Export",
  "type": "object",
  "required": ["schema", "exportedAt", "workspaceVersion", "candidateType", "sourceKey", "capturedAt", "integrity", "readableWorkspace", "raw", "privacy", "governance"],
  "properties": {
    "schema": {"const": "sc-workspace-recovery-candidate/1.0"},
    "exportedAt": {"type": "string"},
    "workspaceVersion": {"type": "string"},
    "candidateType": {"enum": ["current", "last-known-good"]},
    "sourceKey": {"type": "string"},
    "capturedAt": {"type": "string"},
    "integrity": {"type": "object", "required": ["algorithm", "checksum", "bytes"]},
    "readableWorkspace": {"type": "boolean"},
    "raw": {"type": "string"},
    "privacy": {
      "type": "object",
      "required": ["containsCanonicalWorkspaceContent", "automaticUpload", "automaticSubmission"],
      "properties": {
        "containsCanonicalWorkspaceContent": {"const": true},
        "automaticUpload": {"const": false},
        "automaticSubmission": {"const": false}
      }
    },
    "governance": {
      "type": "object",
      "required": ["applyMode", "automaticRestore", "canonicalMutation"],
      "properties": {
        "applyMode": {"const": "manual-review-only"},
        "automaticRestore": {"const": false},
        "canonicalMutation": {"const": false}
      }
    }
  },
  "additionalProperties": true
}
