{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-research-collection-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Smart Research Collection",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "description",
    "criteria",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-research-collection/1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 600
    },
    "criteria": {
      "$ref": "sc-workspace-knowledge-search-v1.schema.json"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
