{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc-workspace-research-handoff-v1.schema.json",
  "title": "Workspace Cross-Product Research Handoff",
  "type": "object",
  "required": [
    "schema",
    "handoffId",
    "sourceProduct",
    "destinationProduct",
    "intent",
    "objects",
    "packageFingerprint"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-research-handoff/1.0"
    },
    "handoffId": {
      "type": "string"
    },
    "sourceProduct": {
      "type": "string"
    },
    "destinationProduct": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "objects": {
      "type": "array"
    },
    "packageFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
