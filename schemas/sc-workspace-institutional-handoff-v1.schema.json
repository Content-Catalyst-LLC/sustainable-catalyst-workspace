{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sustainable Catalyst Workspace Institutional Handoff",
  "type": "object",
  "required": [
    "schema",
    "handoffs",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-institutional-handoff/1.0"
    },
    "handoffs": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "sourceProjectId",
          "targetProduct",
          "status",
          "objectIds",
          "acknowledgements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "sourceProjectId": {
            "type": "string"
          },
          "targetProduct": {
            "const": "catalyst-intelligence-platform"
          },
          "organizationLabel": {
            "type": "string",
            "maxLength": 200
          },
          "purpose": {
            "type": "string",
            "maxLength": 3000
          },
          "status": {
            "enum": [
              "draft",
              "prepared",
              "exported",
              "received",
              "accepted",
              "declined",
              "closed"
            ]
          },
          "objectIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "acknowledgements": {
            "type": "object",
            "required": [
              "copyModel",
              "institutionalGovernance",
              "sharingReviewed"
            ],
            "properties": {
              "copyModel": {
                "const": true
              },
              "institutionalGovernance": {
                "const": true
              },
              "sharingReviewed": {
                "const": true
              }
            }
          },
          "packageFingerprint": {
            "type": "string",
            "maxLength": 128
          },
          "externalRecordId": {
            "type": "string",
            "maxLength": 240
          },
          "receiptNote": {
            "type": "string",
            "maxLength": 3000
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "exportedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "receiptAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "closedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "activeHandoffId": {
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "maxItems": 80
    }
  }
}
