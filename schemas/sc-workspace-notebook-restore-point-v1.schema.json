{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-notebook-restore-point-v1.schema.json",
  "title": "Workspace Notebook Restore Point",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "notebookId",
    "label",
    "createdAt",
    "fingerprint",
    "snapshot"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-notebook-restore-point/1.0"
    },
    "id": {
      "type": "string"
    },
    "notebookId": {
      "type": "string"
    },
    "notebookTitle": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "note": {
      "type": "string",
      "maxLength": 1200
    },
    "createdAt": {
      "type": "string"
    },
    "notebookUpdatedAt": {
      "type": "string"
    },
    "fingerprint": {
      "type": "string"
    },
    "snapshot": {
      "$ref": "sc-workspace-notebook-v3.schema.json"
    }
  }
}
