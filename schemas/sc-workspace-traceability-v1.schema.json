{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-traceability-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidenceAssessments",
    "lineage",
    "reproducibility",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-traceability/1.0"
    },
    "evidenceAssessments": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objectId",
          "relevance",
          "sourceQuality",
          "independence",
          "recency",
          "note",
          "fingerprint",
          "fingerprintAlgorithm",
          "fingerprintState",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "objectId": {
            "type": "string",
            "maxLength": 160
          },
          "relevance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "sourceQuality": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "independence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "recency": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^$|^[a-f0-9]{64}$"
          },
          "fingerprintAlgorithm": {
            "const": "SHA-256"
          },
          "fingerprintState": {
            "enum": [
              "unverified",
              "match",
              "changed"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fromObjectId",
          "toObjectId",
          "relation",
          "note",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "fromObjectId": {
            "type": "string",
            "maxLength": 160
          },
          "toObjectId": {
            "type": "string",
            "maxLength": 160
          },
          "relation": {
            "enum": [
              "derived-from",
              "supports",
              "contradicts",
              "uses",
              "produced-by",
              "informs",
              "supersedes",
              "cites"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "createdAt": {
            "type": "string"
          }
        }
      }
    },
    "reproducibility": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "analysisObjectId",
          "datasetObjectIds",
          "evidenceObjectIds",
          "resultObjectIds",
          "method",
          "parameters",
          "environment",
          "steps",
          "status",
          "createdAt",
          "updatedAt",
          "lastVerifiedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "analysisObjectId": {
            "type": "string",
            "maxLength": 160
          },
          "datasetObjectIds": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "evidenceObjectIds": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "resultObjectIds": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          },
          "method": {
            "type": "string",
            "maxLength": 4000
          },
          "parameters": {
            "type": "string",
            "maxLength": 5000
          },
          "environment": {
            "type": "string",
            "maxLength": 3000
          },
          "steps": {
            "type": "string",
            "maxLength": 8000
          },
          "status": {
            "enum": [
              "draft",
              "ready",
              "verified",
              "stale"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "lastVerifiedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
