{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sc-workspace-native-arrow-table/1.0",
  "type": "object",
  "required": [
    "schema",
    "rowCount",
    "columnCount",
    "columns",
    "schemaFingerprint"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-native-arrow-table/1.0"
    },
    "rowCount": {
      "type": "integer",
      "minimum": 0
    },
    "columnCount": {
      "type": "integer",
      "minimum": 0
    },
    "columns": {
      "type": "array"
    },
    "schemaFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
