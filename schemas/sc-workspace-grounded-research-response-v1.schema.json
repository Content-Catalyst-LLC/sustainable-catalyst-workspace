    "id",
    "response",
    "citations",
    "citationCoverage"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-grounded-research-request/1.0"
    },
    "id": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "citations": {
      "type": "array"
    },
    "citationCoverage": {
      "type": "object"
    }
  }
}
