{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-notebook-ref-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Notebook Reference v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "id",
    "notebookId",
    "sectionId",
    "label"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-notebook-ref/1.0"
    },
    "kind": {
      "enum": [
        "notebook",
        "section",
        "block",
        "object"
      ]
    },
    "id": {
      "type": "string",
      "maxLength": 160
    },
    "notebookId": {
      "type": "string",
      "maxLength": 160
    },
    "sectionId": {
      "type": "string",
      "maxLength": 160
    },
    "label": {
      "type": "string",
      "maxLength": 240
    }
  }
}
