{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainablecatalyst.com/schemas/sc-workspace-notebook-synthesis-v1.schema.json",
  "title": "Sustainable Catalyst Workspace Notebook Synthesis v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "title",
    "selectedRefs",
    "entries",
    "content",
    "citations",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-notebook-synthesis/1.0"
    },
    "id": {
      "type": "string",
      "maxLength": 160
    },
    "kind": {
      "enum": [
        "outline",
        "citation-pack",
        "source-matrix",
        "evidence-summary",
        "research-synthesis"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 240
    },
    "selectedRefs": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "$ref": "sc-workspace-notebook-ref-v1.schema.json"
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "ref",
          "kind",
          "type",
          "label",
          "excerpt",
          "citation",
          "sourceTitle",
          "sourceUrl",
          "tags"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "ref": {
            "$ref": "sc-workspace-notebook-ref-v1.schema.json"
          },
          "kind": {
            "type": "string",
            "maxLength": 40
          },
          "type": {
            "type": "string",
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "maxLength": 240
          },
          "excerpt": {
            "type": "string",
            "maxLength": 1200
          },
          "citation": {
            "type": "string",
            "maxLength": 4000
          },
          "sourceTitle": {
            "type": "string",
            "maxLength": 240
          },
          "sourceUrl": {
            "type": "string",
            "maxLength": 2000
          },
          "tags": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 48
            }
          }
        }
      }
    },
    "content": {
      "type": "string",
      "maxLength": 120000
    },
    "citations": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "ref",
          "citation"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "ref": {
            "$ref": "sc-workspace-notebook-ref-v1.schema.json"
          },
          "citation": {
            "type": "string",
            "maxLength": 4000
          }
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
