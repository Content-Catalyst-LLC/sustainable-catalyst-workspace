{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sustainable Catalyst Workspace Institutional Handoff Receipt",
  "type": "object",
  "required": [
    "schema",
    "handoffId",
    "sourceProjectId",
    "targetProduct",
    "status",
    "receivedAt"
  ],
  "properties": {
    "schema": {
      "const": "sc-workspace-institutional-handoff-receipt/1.0"
    },
    "handoffId": {
      "type": "string"
    },
    "sourceProjectId": {
      "type": "string"
    },
    "targetProduct": {
      "const": "catalyst-intelligence-platform"
    },
    "status": {
      "enum": [
        "received",
        "accepted",
        "declined"
      ]
    },
    "receivedAt": {
      "type": "string"
    },
    "externalRecordId": {
      "type": "string",
      "maxLength": 240
    },
    "note": {
      "type": "string",
      "maxLength": 3000
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "payloadFingerprint": {
          "type": "string"
        },
        "fingerprintAvailable": {
          "type": "boolean"
        }
      }
    }
  }
}
