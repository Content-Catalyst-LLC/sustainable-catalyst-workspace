{
  "name": "@sustainable-catalyst/scientific-publication-tiptap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local, owner-scoped Tiptap 3 scientific manuscript editor for Sustainable Catalyst Reporting Studio",
  "scripts": {
    "build": "esbuild editor.js --bundle --format=iife --target=es2022 --minify --legal-comments=inline --outfile=../app/reporting_publication_tiptap.bundle.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.65.1"
  },
  "engines": {
    "node": ">=22"
  }
}
