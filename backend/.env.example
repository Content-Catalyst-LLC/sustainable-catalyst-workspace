SC_WORKSPACE_DB_PASSWORD=replace-with-strong-password
SC_WORKSPACE_SERVICE_TOKEN=replace-with-long-random-token
SC_WORKSPACE_RUNTIME_ATTESTATION_TOKEN=replace-with-separate-long-random-token
SC_WORKSPACE_ENVIRONMENT=production
