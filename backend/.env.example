SC_WORKSPACE_DATABASE_URL=postgresql+psycopg://sc_workspace:CHANGE_ME@sc-postgres:5432/sc_workspace
SC_WORKSPACE_SERVICE_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
SC_WORKSPACE_ENVIRONMENT=production
SC_WORKSPACE_AUTO_CREATE_SCHEMA=false
SC_WORKSPACE_MAX_PROJECTS_PER_ACCOUNT=100
SC_WORKSPACE_MAX_PROJECT_BYTES=10485760
SC_WORKSPACE_MAX_ACCOUNT_BYTES=536870912
SC_WORKSPACE_MAX_NOTEBOOKS_PER_ACCOUNT=250
SC_WORKSPACE_MAX_NOTEBOOK_BYTES=5242880
