SC_WORKSPACE_DB_PASSWORD=replace-with-strong-password
SC_WORKSPACE_SERVICE_TOKEN=replace-with-long-random-token
SC_WORKSPACE_ENVIRONMENT=production
SC_WORKSPACE_AUTO_CREATE_SCHEMA=false
SC_WORKSPACE_OBJECT_STORAGE_ROOT=/data/objects
SC_WORKSPACE_MAX_PROJECTS_PER_ACCOUNT=100
SC_WORKSPACE_MAX_PROJECT_BYTES=10485760
SC_WORKSPACE_MAX_ACCOUNT_BYTES=536870912
SC_WORKSPACE_MAX_NOTEBOOKS_PER_ACCOUNT=250
SC_WORKSPACE_MAX_NOTEBOOK_BYTES=5242880
SC_WORKSPACE_MAX_ARTIFACTS_PER_ACCOUNT=500
SC_WORKSPACE_MAX_ARTIFACT_BYTES=26214400
SC_WORKSPACE_MAX_ARTIFACT_ACCOUNT_BYTES=2147483648
SC_WORKSPACE_MAX_RECOVERY_SNAPSHOTS_PER_ACCOUNT=50
